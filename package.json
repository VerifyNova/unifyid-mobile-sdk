{
  "name": "unifyid-mobile-sdk-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:source": "node scripts/check.mjs",
    "test": "node --test packages/core/test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:react-native": "node --experimental-vm-modules --test packages/react-native/test/*.test.mjs",
    "check": "npm run check:source && npm test && npm run test:react-native && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}

